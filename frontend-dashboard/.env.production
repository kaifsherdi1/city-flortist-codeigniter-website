# Live build (npm run build). Read by Vite at build time and baked into the JavaScript; no secrets here.
# The CodeIgniter backend (api subdomain). The dashboard calls https://api.cityfloristhubli.com/api/admin/...
VITE_API_URL=https://api.cityfloristhubli.com
# The public website, for the "View site" / "Shop page" / "View on site" links.
VITE_SITE_URL=https://cityfloristhubli.com
# The dashboard has its own subdomain (admin.cityfloristhubli.com), so its pages start at "/".
VITE_ADMIN_BASE=/
