{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "VITE_STATIC_CATALOG=1 npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/((?!api/|uploads/).*)",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/admin",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/admin/(.*)",
            "destination": "/",
            "permanent": false
        }
    ]
}
