# City Florist website (frontend-user build): goes in public_html/ on Hostinger, served at https://cityfloristhubli.com
# public_html/api/ (api subdomain) and public_html/admin/ (admin subdomain) have their own .htaccess files.
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always HTTPS, and one address: www.cityfloristhubli.com → cityfloristhubli.com
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://cityfloristhubli.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://cityfloristhubli.com%{REQUEST_URI} [L,R=301]

  # "/admin" and "/api" without a slash would otherwise get the website's page (the folders' own .htaccess files
  # only see "/admin/…" and "/api/…").
  RewriteRule ^admin$ https://admin.cityfloristhubli.com/ [L,R=301]
  RewriteRule ^api$ - [F,L]

  # The live sitemap is made by the backend.
  RewriteRule ^sitemap\.xml$ https://api.cityfloristhubli.com/sitemap.xml [L,R=302]

  # Real files (JS, CSS, images) are served directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Every other URL is a page of the React app (/shop, /product/…, /login, /account …).
  # Missing photos and scripts stay a 404 instead of returning the page.
  RewriteCond %{REQUEST_URI} !^/(catalog|img|assets)/
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Only this site's own scripts may run. Data and photos come from the API subdomain.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://api.cityfloristhubli.com; connect-src 'self' https://api.cityfloristhubli.com; frame-src https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  <FilesMatch "\.(js|css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
