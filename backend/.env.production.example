# City Florist: .env for the LIVE API (Hostinger, https://api.cityfloristhubli.com).
# Copy to public_html/api/.env on the server and fill in every value marked <…>. Never commit the real file.
# A value with spaces or a # in it must stay inside double quotes, like the passwords below.
#
#   https://cityfloristhubli.com        website (frontend-user)       → public_html/
#   https://admin.cityfloristhubli.com  dashboard (frontend-dashboard) → public_html/admin/
#   https://api.cityfloristhubli.com    this backend (CodeIgniter)     → public_html/api/

# Must stay production on the live site: development shows error details (file paths, database errors) to
# visitors, takes the HTTPS-only flag off the login cookies and lets the installer use the example password.
CI_ENVIRONMENT = production

# This backend's own address (ends with a slash). Google sign-in callbacks and photo URLs are built from it.
app.baseURL = 'https://api.cityfloristhubli.com/'

# Generate on your computer: cd backend && php spark key:generate --show
# Keep a private copy: two-step login secrets are encrypted with this key, so changing it turns two-step off.
# Moving from the Laravel version: use its APP_KEY here instead (encryption.key = base64:…).
encryption.key = <hex2bin:…>

#--------------------------------------------------------------------
# THE THREE DOMAINS
#--------------------------------------------------------------------
# The public website: emailed links, the sitemap, WhatsApp orders, and where customers land after Google sign-in.
florist.siteUrl = https://cityfloristhubli.com
# The owner dashboard: password-reset links and where the owner lands after Google sign-in.
florist.adminUrl = https://admin.cityfloristhubli.com
# The website and the dashboard call this API from their own domains: turns on CORS for exactly those two
# (www.cityfloristhubli.com is allowed too), and makes photo URLs absolute (https://api.cityfloristhubli.com/uploads/…).
florist.separateDomains = true
# Extra origins allowed to call the API, comma-separated. Leave empty on the live site.
florist.corsOrigins =

# The login cookies (session, "remember me", XSRF-TOKEN) are shared by all three subdomains, so the dashboard
# and the website can read the CSRF token the API hands out. Keep the leading dot.
cookie.domain = .cityfloristhubli.com

#--------------------------------------------------------------------
# SHOP
#--------------------------------------------------------------------
florist.whatsappNumber = 919900094843
# First login, created by the dashboard's Install screen. The installer refuses the example password and anything
# under 10 characters. You'll be asked to change it again on first login, so this one never stays in use.
florist.adminUsername = <owner>
florist.adminPassword = "<a long random password>"
# Also logs in with these; the email gets password-reset links and is the Google account allowed in.
florist.adminEmail = cityfloristh@gmail.com
florist.adminPhone = 9900094843

#--------------------------------------------------------------------
# DATABASE: hPanel → Databases → MySQL Databases
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.port = 3306
database.default.database = <u481230984_florist>
database.default.username = <u481230984_florist>
database.default.password = "<database password>"

# Logged in for 12 hours of inactivity ("Remember me" keeps the owner logged in longer on their own phone).
# Login cookies are HTTPS-only because CI_ENVIRONMENT is production.
session.expiration = 43200

# Errors and warnings go to writable/logs/log-<date>.log (one file a day).
logger.threshold = 5

# Only if a CDN/proxy (e.g. Cloudflare) sits in front of the site: its IP ranges, comma-separated.
# Leave empty otherwise, or visitors could fake their IP and dodge the login limit.
florist.trustedProxies =

#--------------------------------------------------------------------
# EMAIL: password-reset emails. hPanel → Emails → create no-reply@cityfloristhubli.com.
#--------------------------------------------------------------------
florist.mailer = smtp
email.SMTPHost = smtp.hostinger.com
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.SMTPUser = no-reply@cityfloristhubli.com
email.SMTPPass = "<mailbox password>"
email.fromEmail = no-reply@cityfloristhubli.com
email.fromName = "City Florist"

#--------------------------------------------------------------------
# Optional "Continue with Google". console.cloud.google.com → Credentials → OAuth client ID (Web application).
# Authorised JavaScript origins: https://cityfloristhubli.com and https://admin.cityfloristhubli.com
# Authorised redirect URIs (add both):
#   https://api.cityfloristhubli.com/api/admin/oauth/google/callback     (dashboard)
#   https://api.cityfloristhubli.com/api/account/oauth/google/callback   (customer accounts)
#--------------------------------------------------------------------
florist.googleClientId =
florist.googleClientSecret =
