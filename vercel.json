{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "cd frontend-user && npm ci",
    "buildCommand": "cd frontend-user && VITE_STATIC_CATALOG=1 npm run build",
    "outputDirectory": "frontend-user/dist",
    "rewrites": [
        {
            "source": "/((?!api/|uploads/).*)",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/admin",
            "destination": "/",
            "permanent": false
        },
        {
            "source": "/admin/(.*)",
            "destination": "/",
            "permanent": false
        }
    ]
}
