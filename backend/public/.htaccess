# City Florist: CodeIgniter's public/ folder on Hostinger (Apache/LiteSpeed).
# public/ holds the built React apps (index.html, admin.html, assets/ …) next to CodeIgniter's index.php.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass auth and CSRF headers through to PHP
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{HTTP:x-xsrf-token} .
  RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

  # Uploaded photos are never run as code
  RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh)$ - [F,L,NC]

  # Real files (photos, JS, CSS) are served directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # API, the sitemap and the health check → CodeIgniter
  RewriteRule ^api(/|$) index.php [L]
  RewriteRule ^sitemap\.xml$ index.php [L]
  RewriteRule ^up$ index.php [L]

  # Owner dashboard (React) → admin.html
  RewriteRule ^admin(/.*)?$ admin.html [L]

  # Public website (React) → index.html. Missing photos stay a 404 instead of returning the page.
  RewriteCond %{REQUEST_URI} !^/(uploads|catalog)/
  RewriteRule ^ index.html [L]

  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Only this site's own scripts may run (same policy as app/Filters/SecurityHeaders.php).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # The owner's dashboard should never appear in search results.
  <FilesMatch "^admin\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
