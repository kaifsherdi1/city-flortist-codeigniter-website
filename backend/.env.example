#--------------------------------------------------------------------
# City Florist: copy to .env and fill in. .env is never committed and never overwritten by deploys.
#--------------------------------------------------------------------

# development locally (detailed errors), production on the live site.
CI_ENVIRONMENT = development

# Where this backend runs. `php spark serve --host 127.0.0.1 --port 8000` (composer dev) serves it here, and both
# Vite dev servers forward /api and /uploads to it.
app.baseURL = 'http://127.0.0.1:8000/'

# Signs "remember me" cookies and encrypts two-step login secrets. Generate with: php spark key:generate
# (Moving from the Laravel version? Use its APP_KEY here, e.g. encryption.key = base64:…, and existing
# two-step logins keep working.)
encryption.key =

#--------------------------------------------------------------------
# DATABASE: MySQL only (MariaDB is fine: XAMPP and Hostinger both use it). Create it first:
#   CREATE DATABASE cityflorist_ci CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# The tables are the same as the Laravel version's, so this can also point at that version's database.
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.port = 3306
database.default.database = cityflorist_ci
database.default.username = root
database.default.password =

# The database the tests wipe and refill (never the site's own): php spark ... / composer test
database.tests.hostname = 127.0.0.1
database.tests.port = 3306
database.tests.database = cityflorist_ci_test
database.tests.username = root
database.tests.password =

#--------------------------------------------------------------------
# CITY FLORIST
#--------------------------------------------------------------------
# Public website URL, used in emailed links and the sitemap (the Vite site in development).
florist.siteUrl = http://localhost:5173
# Default WhatsApp number for orders (country code + number). Editable later in Admin → Settings.
florist.whatsappNumber = 919900094843
# First admin login, created by the installer. Change the password in Settings after the first login.
florist.adminUsername = admin
florist.adminPassword = ChangeMe@123
florist.adminEmail = cityfloristh@gmail.com
florist.adminPhone = 9900094843

# Only if the site sits behind a CDN or proxy you control (e.g. Cloudflare): its IP ranges, comma-separated.
# Leave empty on plain Hostinger. Trusting everyone would let visitors fake their IP and dodge the login limit.
# florist.trustedProxies =

#--------------------------------------------------------------------
# SESSION: logged in for 12 hours of inactivity ("Remember me" keeps the owner logged in longer).
# On the live site (CI_ENVIRONMENT = production) the login cookies are HTTPS-only automatically.
#--------------------------------------------------------------------
# session.expiration = 43200

#--------------------------------------------------------------------
# EMAIL: password-reset links. "log" only writes them to writable/logs (fine for local testing).
# On Hostinger: hPanel → Emails → create e.g. no-reply@yourdomain.com, then:
# florist.mailer = smtp
# email.SMTPHost = smtp.hostinger.com
# email.SMTPPort = 465
# email.SMTPCrypto = ssl
# email.SMTPUser = no-reply@yourdomain.com
# email.SMTPPass = your-mailbox-password
# email.fromEmail = no-reply@yourdomain.com
# email.fromName = "City Florist"
#--------------------------------------------------------------------
florist.mailer = log

#--------------------------------------------------------------------
# "Continue with Google" (optional). console.cloud.google.com → Credentials → OAuth client ID (Web application).
# Authorised redirect URIs: https://yourdomain.com/api/admin/oauth/google/callback (dashboard)
# and https://yourdomain.com/api/account/oauth/google/callback (customer accounts)
#--------------------------------------------------------------------
# florist.googleClientId =
# florist.googleClientSecret =

#--------------------------------------------------------------------
# LOGS: writable/logs/log-<date>.log
#--------------------------------------------------------------------
# logger.threshold = 4
